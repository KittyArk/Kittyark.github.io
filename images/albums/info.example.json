// ─────────────────────────────────────────────────────────────
// 相册模板示例（本文件不会被相册扫描器加载——相册只认目录里叫 info.json 的文件）
//
// 用法：建目录 public/images/albums/<相册slug>/ → 把本文件复制进去改名为
// info.json → 删除所有 "//" 注释行（info.json 必须是纯 JSON）→ 填好字段。
// 目录名即相册 URL：public/images/albums/trip-2024/ → /albums/trip-2024/
//
// 四种模式：本地相册（默认）/ 外链相册 / 加密相册 / 隐藏相册，见下方分段注释。
// ─────────────────────────────────────────────────────────────
{
	// 相册标题（列表页与详情页显示）
	"title": "示例相册",
	// 一句话描述
	"description": "我的第一本相册",
	// 相册日期 YYYY-MM-DD
	"date": "2026-11-26",
	// 拍摄地点（可留空）
	"location": "",
	// 标签数组（可留空）
	"tags": ["风景"],
	// 布局："masonry" 瀑布流 | "grid" 网格
	"layout": "masonry",
	// 列数
	"columns": 3,
	// true = 不出现在相册列表，仅直链可访问（隐藏相册模式）
	"hidden": false,

	// ── 外链相册模式：照片不放目录里，引用远程图床 URL ──
	// 启用时取消注释（本地相册模式则删除这段，直接把图片文件放进目录）：
	// "mode": "external",
	// "cover": "https://example.com/cover.jpg",
	// "photos": [
	// 	{
	// 		"id": "photo-1",
	// 		"src": "https://example.com/full/1.jpg",
	// 		"thumbnail": "https://example.com/thumb/1.jpg",
	// 		"alt": "无障碍描述",
	// 		"title": "照片标题",
	// 		"tags": ["风景"],
	// 		"width": 1920,
	// 		"height": 1280
	// 	}
	// ],

	// ── 加密相册模式：在上面任意模式基础上追加这两个字段 ──
	// "password": "123456",
	// "passwordHint": "六位数字"
}
